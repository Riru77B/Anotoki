<%# 周りから見たあなた（他者診断との比較） %>
<section class="flex flex-col gap-3">
  <h2 class="text-lg font-bold">周りから見たあなた</h2>

  <% if comparison.any_respondents? %>
    <p class="text-sm text-gray-600"><%= comparison.respondent_count %>人が回答してくれました。回答してくれた全員の平均と比べています。</p>

    <div class="flex flex-col gap-3">
      <h3 class="font-bold">自分では気づいていない強み</h3>
      <% if (hidden = comparison.hidden_strengths).any? %>
        <% hidden.each do |row| %>
          <div class="rounded-xl border-2 border-sky-300 bg-white/80 p-4">
            <p class="text-xl font-bold"><%= row.diagnosis_axis.name %></p>
            <p class="mt-2 leading-relaxed">
              自分では <span class="font-bold"><%= row.self_score %></span> でしたが、周りからは
              <span class="font-bold text-sky-700"><%= row.other_score %></span> と見られています。
            </p>
            <div class="mt-3 rounded-lg bg-white p-3 text-sm leading-relaxed text-gray-700 ring-1 ring-sky-200">
              <p class="font-bold text-sky-700">🔍 振り返ってみよう</p>
              <p class="mt-1"><%= row.diagnosis_axis.reflection_prompt %></p>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="rounded-xl border border-gray-200 bg-white/80 p-4 text-sm text-gray-700">
          自分の見方と周りの見方に、大きなずれはありませんでした。周りからも、あなたが思っているとおりに見られています。
        </p>
      <% end %>
    </div>

    <table class="w-full overflow-hidden rounded-xl border border-gray-200 bg-white/80 text-sm">
      <thead class="bg-gray-50 text-gray-600">
        <tr>
          <th class="p-2 text-left font-bold">診断軸</th>
          <th class="p-2 text-right font-bold">自分</th>
          <th class="p-2 text-right font-bold">周り</th>
          <th class="p-2 text-right font-bold">差</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% comparison.rows.each do |row| %>
          <tr>
            <td class="p-2"><%= row.diagnosis_axis.name %></td>
            <td class="p-2 text-right"><%= row.self_score %></td>
            <td class="p-2 text-right"><%= row.other_score %></td>
            <td class="p-2 text-right font-bold <%= row.gap >= ScoreComparison::HIDDEN_STRENGTH_GAP ? "text-sky-700" : "text-gray-500" %>">
              <%= row.gap.positive? ? "+#{row.gap}" : row.gap %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-white/80 p-5">
      <p class="text-sm text-gray-700">まだ誰も回答していません。家族や友人に回答をお願いすると、ここに「周りから見たあなた」が表示され、自分では気づいていない強みが見つかります。</p>
      <%= render "shared/invitation_url", user: current_user %>
    </div>
  <% end %>
</section>
