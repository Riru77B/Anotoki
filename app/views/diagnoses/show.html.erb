<% content_for :title, "診断結果 | じぶんノート" %>
<div class="flex flex-col gap-8">
  <div class="text-center">
    <p class="text-sm font-bold tracking-widest text-orange-500">YOUR USER MANUAL</p>
    <h1 class="mt-1 text-2xl font-bold"><%= current_user.name %> さんの診断結果</h1>
    <p class="mt-1 text-sm text-gray-500"><%= l(@diagnosis.completed_at, format: :long) %></p>
  </div>

  <section class="flex flex-col gap-3">
    <h2 class="text-lg font-bold">あなたの強み TOP3</h2>
    <ol class="flex flex-col gap-3">
      <% @diagnosis.top_strengths.each.with_index(1) do |score, rank| %>
        <li class="flex items-center gap-4 rounded-xl border-2 p-4 <%= rank == 1 ? "border-orange-500 bg-orange-50" : "border-gray-200" %>">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-bold <%= rank == 1 ? "bg-orange-500 text-white" : "bg-gray-100 text-gray-700" %>"><%= rank %></span>
          <div>
            <p class="<%= rank == 1 ? "text-2xl" : "text-xl" %> font-bold"><%= score.diagnosis_axis.name %></p>
            <p class="text-sm text-gray-600"><%= score.diagnosis_axis.description %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-lg font-bold">7つの診断軸</h2>

    <% summary = @scores.map { |s| "#{s.diagnosis_axis.name} #{s.score}" }.join("、") %>
    <div class="mx-auto w-full max-w-sm"
         data-controller="radar-chart"
         data-radar-chart-labels-value="<%= @scores.map { |s| s.diagnosis_axis.name }.to_json %>"
         data-radar-chart-scores-value="<%= @scores.map(&:score).to_json %>">
      <canvas data-radar-chart-target="canvas" role="img" aria-label="7つの診断軸のレーダーチャート：<%= summary %>">
        <%= summary %>
      </canvas>
    </div>

    <% @scores.each do |score| %>
      <div>
        <div class="flex items-baseline justify-between">
          <span class="font-bold"><%= score.diagnosis_axis.name %></span>
          <span><span class="text-xl font-bold"><%= score.score %></span><span class="text-sm text-gray-500"> / 100</span></span>
        </div>
        <div class="mt-1 h-3 rounded-full bg-gray-200">
          <div class="h-3 rounded-full bg-orange-500" style="width: <%= score.score %>%"></div>
        </div>
        <p class="mt-1 text-xs text-gray-500"><%= score.diagnosis_axis.description %></p>
      </div>
    <% end %>
  </section>

  <div class="text-center">
    <%= link_to "マイページに戻る", mypage_path, class: "btn-secondary" %>
  </div>
</div>
