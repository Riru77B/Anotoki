<header class="flex items-center justify-between border-b border-white/60 bg-white/60 px-4 py-3 backdrop-blur">
  <%= link_to "じぶんノート", root_path, class: "font-bold" %>

  <nav class="flex items-center gap-4 text-sm">
    <% if user_signed_in? %>
      <%= link_to "マイページ", mypage_path %>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "cursor-pointer underline" %>
    <% else %>
      <%= link_to "ログイン", new_user_session_path %>
      <%= link_to "新規登録", new_user_registration_path, class: "rounded-full bg-orange-500 px-4 py-1 font-bold text-white" %>
    <% end %>
  </nav>
</header>
