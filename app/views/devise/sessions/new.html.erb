<% content_for :title, "ログイン | あのときリンク" %>
<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-center text-2xl font-bold"><%= t('.sign_in') %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <div>
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2 text-sm">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <%= f.submit t('.sign_in'), class: "btn-primary mt-2" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
