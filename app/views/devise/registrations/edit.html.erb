<% content_for :title, "アカウント設定 | あのときリンク" %>
<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-center text-2xl font-bold">アカウント設定</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, autocomplete: "nickname", maxlength: 30, class: "form-input" %>
    </div>

    <div>
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "form-input" %>
    </div>

    <div>
      <%= f.label :password, "新しいパスワード", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
      <p class="form-hint"><%= t('.leave_blank_if_you_don_t_want_to_change_it') %></p>
    </div>

    <div>
      <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
    </div>

    <div>
      <%= f.label :current_password, class: "form-label" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
      <p class="form-hint"><%= t('.we_need_your_current_password_to_confirm_your_changes') %></p>
    </div>

    <%= f.submit t('.update'), class: "btn-primary mt-2" %>
  <% end %>

  <div class="mt-10 border-t border-gray-200 pt-6 text-center text-sm">
    <p class="mb-3 text-gray-600">アカウントを削除すると、診断結果もすべて消えます。</p>
    <%= button_to t('.cancel_my_account'), registration_path(resource_name), method: :delete,
          data: { turbo_confirm: t('.are_you_sure') }, class: "cursor-pointer text-red-600 underline" %>
  </div>

  <div class="mt-6 text-center text-sm">
    <%= link_to "マイページに戻る", mypage_path, class: "text-link" %>
  </div>
</div>
