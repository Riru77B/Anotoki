<% content_for :title, "パスワードの再設定 | あのときリンク" %>
<div class="mx-auto max-w-sm">
  <h1 class="mb-3 text-center text-2xl font-bold">パスワードの再設定</h1>
  <p class="mb-6 text-sm leading-relaxed text-gray-700">
    登録したメールアドレスを入力してください。パスワードを再設定するためのリンクをメールでお送りします。
  </p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <%= f.submit "再設定メールを送る", class: "btn-primary mt-2" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
