<div class="mt-6 flex flex-col items-center gap-2 text-sm">
  <%- if controller_name != 'sessions' %>
    <p>登録済みの方は <%= link_to t(".sign_in"), new_session_path(resource_name), class: "text-link" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p>はじめての方は <%= link_to t(".sign_up"), new_registration_path(resource_name), class: "text-link" %></p>
  <% end %>
</div>
